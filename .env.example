FSTEC_DATABASE_URL=sqlite:///./data/fstec-monitor.db
FSTEC_STORAGE_DIR=./data/objects
FSTEC_BASE_URL=https://fstec.ru
FSTEC_CATALOG_URL=https://fstec.ru/dokumenty/vse-dokumenty
FSTEC_USER_AGENT=FSTEC-Monitor/0.1 (+mailto:admin@example.org)
FSTEC_REQUEST_DELAY_SECONDS=2
FSTEC_TIMEOUT_SECONDS=45
FSTEC_MAX_RETRIES=3
FSTEC_TELEGRAM_BOT_TOKEN=
FSTEC_TELEGRAM_CHAT_ID=
FSTEC_TELEGRAM_ADMIN_ID=151599744
FSTEC_TELEGRAM_API_ROOT=http://127.0.0.1:8081
FSTEC_SCAN_INTERVAL_SECONDS=7200
# The fstec.ru certificate chain is not trusted by the server's default CA bundle.
# Prefer true after installing the official Russian Trusted Sub CA certificate.
FSTEC_TLS_VERIFY=false
# Hard application-data limit. Existing versions are never deleted automatically.
FSTEC_STORAGE_QUOTA_BYTES=5368709120
# Files larger than this are kept on the server but not uploaded back to Telegram.
FSTEC_TELEGRAM_MAX_FILE_BYTES=47185920
