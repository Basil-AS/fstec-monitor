[Unit]
Description=FSTEC Monitor Telegram bot container
Wants=telegram-bot-api.service
After=telegram-bot-api.service

[Container]
Image=__FSTEC_MONITOR_IMAGE__
ContainerName=fstec-monitor
Network=bots-net
EnvironmentFile=/srv/runtime/secrets/fstec-monitor.env
EnvironmentFile=-/srv/runtime/secrets/telegram-admin.env
Environment=FSTEC_TELEGRAM_API_ROOT=http://telegram-bot-api:8081
Environment=FSTEC_DATABASE_URL=sqlite:////data/fstec-monitor.db
Environment=FSTEC_STORAGE_DIR=/data/objects
Volume=/srv/runtime/apps/fstec-monitor/data:/data:Z
UserNS=keep-id:uid=1002,gid=1002
User=1002:1002
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Tmpfs=/tmp:rw,noexec,nosuid,size=64m
LogDriver=journald
Notify=container
HealthCmd=/app/.venv/bin/python -m fstec_monitor.healthcheck
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=60s
HealthOnFailure=kill

[Service]
Type=notify
NotifyAccess=all
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=30s
WatchdogSec=60s
TasksMax=512
CPUWeight=100
MemoryHigh=768M
MemoryMax=1G

[Install]
WantedBy=default.target
