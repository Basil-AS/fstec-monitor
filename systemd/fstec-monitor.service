[Unit]
Description=FSTEC document change monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fstec-monitor
Group=fstec-monitor
WorkingDirectory=/opt/fstec-monitor
EnvironmentFile=/etc/fstec-monitor.env
ExecStart=/opt/fstec-monitor/.venv/bin/fstec-monitor run
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fstec-monitor
